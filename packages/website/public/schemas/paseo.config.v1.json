{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "daemon": {
      "type": "object",
      "properties": {
        "listen": {
          "type": "string"
        },
        "hostnames": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "allowedHosts": {
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "trustedProxies": {
          "description": "Express trusted proxy setting for X-Forwarded-* headers. Defaults to [\"loopback\"]. Use true only when the final trusted proxy overwrites client-supplied forwarded headers.",
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "injectIntoAgents": {
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        },
        "usage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "browserTools": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": {}
        },
        "git": {
          "type": "object",
          "properties": {
            "maxProcessesPerSecond": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "maxProcessConcurrency": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "autoArchiveAfterMerge": {
          "type": "boolean"
        },
        "enableTerminalAgentHooks": {
          "type": "boolean"
        },
        "remoteAccess": {
          "type": "object",
          "properties": {
            "outbound": {
              "default": {
                "enabled": false,
                "peers": [],
                "chats": false,
                "agents": false,
                "files": "off",
                "commands": {
                  "mode": "any",
                  "allowlist": [],
                  "timeoutMs": 120000,
                  "maxOutputBytes": 1048576
                },
                "restrictToWorkspaces": true
              },
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "type": "boolean"
                },
                "peers": {
                  "default": [],
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "chats": {
                  "default": false,
                  "type": "boolean"
                },
                "agents": {
                  "default": false,
                  "type": "boolean"
                },
                "files": {
                  "default": "off",
                  "type": "string",
                  "enum": ["off", "read", "write"]
                },
                "commands": {
                  "default": {
                    "mode": "any",
                    "allowlist": [],
                    "timeoutMs": 120000,
                    "maxOutputBytes": 1048576
                  },
                  "type": "object",
                  "properties": {
                    "mode": {
                      "default": "any",
                      "type": "string",
                      "enum": ["off", "allowlist", "any"]
                    },
                    "allowlist": {
                      "default": [],
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      }
                    },
                    "timeoutMs": {
                      "default": 120000,
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 600000
                    },
                    "maxOutputBytes": {
                      "default": 1048576,
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 16777216
                    }
                  },
                  "additionalProperties": false
                },
                "restrictToWorkspaces": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "inbound": {
              "default": {
                "enabled": false,
                "peers": [],
                "chats": false,
                "agents": false,
                "files": "off",
                "commands": {
                  "mode": "any",
                  "allowlist": [],
                  "timeoutMs": 120000,
                  "maxOutputBytes": 1048576
                },
                "restrictToWorkspaces": true
              },
              "type": "object",
              "properties": {
                "enabled": {
                  "default": false,
                  "type": "boolean"
                },
                "peers": {
                  "default": [],
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "chats": {
                  "default": false,
                  "type": "boolean"
                },
                "agents": {
                  "default": false,
                  "type": "boolean"
                },
                "files": {
                  "default": "off",
                  "type": "string",
                  "enum": ["off", "read", "write"]
                },
                "commands": {
                  "default": {
                    "mode": "any",
                    "allowlist": [],
                    "timeoutMs": 120000,
                    "maxOutputBytes": 1048576
                  },
                  "type": "object",
                  "properties": {
                    "mode": {
                      "default": "any",
                      "type": "string",
                      "enum": ["off", "allowlist", "any"]
                    },
                    "allowlist": {
                      "default": [],
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      }
                    },
                    "timeoutMs": {
                      "default": 120000,
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 600000
                    },
                    "maxOutputBytes": {
                      "default": 1048576,
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 16777216
                    }
                  },
                  "additionalProperties": false
                },
                "restrictToWorkspaces": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "appendSystemPrompt": {
          "type": "string"
        },
        "selfLabel": {
          "type": "string"
        },
        "terminalProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "icon": {
                "type": "string"
              }
            },
            "required": ["id", "name", "command"],
            "additionalProperties": {}
          }
        },
        "agentProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "modeId": {
                "type": "string"
              },
              "thinkingOptionId": {
                "type": "string"
              },
              "featureValues": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "notes": {
                "type": "string"
              }
            },
            "required": ["id", "name", "provider"],
            "additionalProperties": {}
          }
        },
        "mcpServers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "command"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "sse"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "alwaysLoad": {
                    "type": "boolean"
                  }
                },
                "required": ["type", "url"]
              }
            ]
          }
        },
        "mcpShares": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["hosts"],
            "additionalProperties": false
          }
        },
        "mcpBridges": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "via": {
                "type": "string",
                "minLength": 1
              },
              "server": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["host", "server"],
            "additionalProperties": false
          }
        },
        "cors": {
          "type": "object",
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "relay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "requireProtectedSecurity": {
              "description": "Admit only relay clients that negotiate protected endpoint security (replay protection). Defaults to false; older clients still connect while it is off.",
              "type": "boolean"
            },
            "endpoint": {
              "type": "string"
            },
            "publicEndpoint": {
              "type": "string"
            },
            "useTls": {
              "type": "boolean"
            },
            "publicUseTls": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "serviceProxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "description": "Compatibility shim. false suppresses optional service proxy listen/public layers only; localhost proxying remains enabled.",
              "type": "boolean"
            },
            "listen": {
              "description": "Optional service-only listener address. Presence enables the standalone service proxy listener.",
              "type": "string"
            },
            "publicBaseUrl": {
              "description": "Optional public base URL for service host aliases.",
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "password": {
              "type": "string",
              "pattern": "^\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hub": {
      "type": "object",
      "properties": {
        "allowHttp": {
          "description": "Accept cleartext HTTP Hub origins that are not loopback. Off unless set. CLI credentials then travel without TLS.",
          "type": "boolean"
        },
        "publicOrigin": {
          "description": "Origin this computer's local Hub is reachable on from other machines, for example http://100.66.222.98:25000. The Hub process still listens on its own port; this is the address the app and other daemons open.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "local": {
          "type": "object",
          "properties": {
            "modelsDir": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pluginRegistries": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "authorization": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["authorization"]
      }
    },
    "pluginsEnabled": {
      "type": "boolean"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "directory"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": ["source", "path"],
            "additionalProperties": false
          }
        ]
      }
    },
    "worktrees": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "servicePorts": {
          "type": "object",
          "properties": {
            "range": {
              "type": "string",
              "pattern": "^(\\d{1,5})-(\\d{1,5})$"
            },
            "portScript": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "providers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "extends": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "params": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "thinkingOptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "label"]
                      }
                    }
                  },
                  "required": ["id", "label"]
                }
              },
              "additionalModels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string"
                    },
                    "isDefault": {
                      "type": "boolean"
                    },
                    "thinkingOptions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isDefault": {
                            "type": "boolean"
                          }
                        },
                        "required": ["id", "label"]
                      }
                    }
                  },
                  "required": ["id", "label"]
                }
              },
              "disabledModelIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "disallowedTools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "paseoTools": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "disabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "enabled": {
                "type": "boolean"
              },
              "order": {
                "type": "number"
              }
            }
          }
        },
        "idleRuntimeCleanup": {
          "type": "boolean"
        },
        "idleRuntimeCleanupAfter": {
          "description": "How long a resumable agent stays idle before its process is released. One of 15m, 30m, 1h, 2h, 4h, 8h, 24h. Defaults to 1h.",
          "type": "string",
          "enum": ["15m", "30m", "1h", "2h", "4h", "8h", "24h"]
        },
        "resumeOnStartup": {
          "description": "Resume agents interrupted by a daemon restart. Defaults to true.",
          "type": "boolean"
        },
        "resumePrompt": {
          "description": "Prompt sent to an interrupted agent when it resumes. Defaults to 'Resume working.'",
          "type": "string"
        },
        "catalogRefreshTimeoutMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 2147483647
        },
        "metadataGeneration": {
          "type": "object",
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "thinkingOptionId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["provider"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "modelRouters": {
          "type": "object",
          "properties": {
            "routers": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "icon": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["distribution", "fallback"]
                  },
                  "targets": {
                    "minItems": 1,
                    "maxItems": 32,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1
                        },
                        "model": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "weight": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 1000
                        }
                      },
                      "required": ["provider"],
                      "additionalProperties": false
                    }
                  },
                  "hideModelsInSearch": {
                    "type": "boolean"
                  }
                },
                "required": ["id", "name", "mode", "targets"],
                "additionalProperties": false
              }
            },
            "defaultRouterId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "selection": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "all"
                    }
                  },
                  "required": ["mode"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "const": "custom"
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["mode", "skills"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "dictation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "stt": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "local"
                    },
                    "model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "language": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["provider"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "type": "string",
                      "const": "openai"
                    },
                    "apiKey": {
                      "type": "string",
